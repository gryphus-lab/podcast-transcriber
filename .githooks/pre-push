#!/bin/sh
set -eu

has_branch=0
while read -r local_ref local_sha remote_ref remote_sha; do
    case "$local_ref" in
        refs/heads/*)
            has_branch=1
            ;;
        *)
            :
            ;;
    esac
done

if [ "$has_branch" -eq 1 ]; then
    exec uv run --no-sync python scripts/check_version.py \
        --base-ref "${VERSION_BASE_REF:-origin/main}"
fi
